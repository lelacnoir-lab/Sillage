+/* Copy one complete song column. New records are prepared before any destination
+ * entry is published, so a failed write leaves the arrangement untouched. */
+static int song_copy_all(uint32_t source, uint32_t dest)
+{
+    uint8_t ids[NTRK], reps[NTRK], sounds[NTRK][2];
+    uint64_t taken = 0;
+    uint32_t k, created = 0, populated = 0;
+    if (transport_busy()) {
+        ui_message("STOP TO COPY ALL");
+        return 1;
+    }
+    if (!BK_ON || source >= NENT || dest >= NENT || source == dest) {
+        ui_message("CHOOSE ANOTHER DEST");
+        return 1;
+    }
+    bank_poll();
+    for (k = 0; k < NTRK; k++) {
+        if (lists.ent[k][dest][0] || (dest && ent_link(k, dest - 1u))) {
+            ui_message("DESTINATION NOT EMPTY");
+            return 1;
+        }
+        if (ent_link(k, source) || (source && ent_link(k, source - 1u))) {
+            ui_message("CHAIN: USE TRACK COPY+");
+            return 1;
+        }
+        uint32_t id = ent_pat(k, source);
+        int live = lists.cur[k] == source &&
+                   (id != PAT_NONE || !seq_is_empty(&trk[k]) || motion_count(&trk[k]));
+        ids[k] = lists.ent[k][source][0];
+        reps[k] = lists.ent[k][source][1];
+        memcpy(sounds[k], lists.snd[k][source], 2);
+        if (id == PAT_NONE && !live)
+            continue;
+        uint32_t free_id = pool_free_after(id == PAT_NONE ? NPAT - 1u : id, taken);
+        if (free_id == NPAT) {
+            ui_message("PATTERNS FULL");
+            return 1;
+        }
+        ids[k] = (uint8_t)(free_id + 1u);
+        taken |= (uint64_t)1u << free_id;
+        populated |= 1u << k;
+        if ((live && !trk_rec(k)) || (!live && pat_read(id, bk_rec))) {
+            ui_message("SOURCE READ FAILED");
+            return 1;
+        }
+    }
+    if (!populated) {
+        ui_message("NOTHING TO COPY");
+        return 1;
+    }
+    for (k = 0; k < NTRK; k++) {
+        if (!(populated & (1u << k)))
+            continue;
+        uint32_t id = ent_pat(k, source);
+        int live = lists.cur[k] == source;
+        if ((live && !trk_rec(k)) || (!live && pat_read(id, bk_rec)) || pat_keep_now(ids[k] - 1u, bk_rec))
+            goto failed;
+        created |= 1u << k;
+    }
+    while (pend_free() < PEND_N)
+        if (pat_flush_one())
+            goto failed;
+    fm1_irq_off();
+    for (k = 0; k < NTRK; k++) {
+        lists.ent[k][dest][0] = ids[k];
+        lists.ent[k][dest][1] = reps[k];
+        memcpy(lists.snd[k][dest], sounds[k], 2);
+    }
+    bk.gen++;
+    fm1_irq_on();
+    char message[] = "COPIED ALL A TO B";
+    message[11] = (char)('A' + source);
+    message[16] = (char)('A' + dest);
+    ui_message(message);
+    return 0;
+failed:
+    memset(bk_rec, 0, BK_REC);
+    for (k = 0; k < NTRK; k++)
+        if (created & (1u << k))
+            (void)pat_keep_now(ids[k] - 1u, bk_rec);
+    ui_message("COPY FAILED: DEST EMPTY");
+    return 1;
+}
