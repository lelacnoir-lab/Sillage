+static __attribute__((noinline)) void cast_px(uint32_t xywh, uint32_t c, const uint16_t *p, uint32_t n)
+{
+    uint32_t h = cast.px;
+    if (cast.on != 1u)
+        return;
+    h = (h ^ xywh) * 16777619u;
+    h = (h ^ c) * 16777619u;
+    while (n--)
+        h = (h ^ *p++) * 16777619u;
+    cast.px = h;
